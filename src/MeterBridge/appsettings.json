{
  "Mqtt": {
    "Host": "10.1.0.10",
    "Port": 1883,
    "ClientId": "meter-bridge-pi",
    "Username": "",
    "Password": ""
  },
  "Huawei": {
    "Enabled": true,
    "DongleIp": "192.168.200.1",
    "Port": 502,
    "UnitId": 1,
    "PollSeconds": 30,
