    "Topic": "meterbridge/gaszaehler/pv",
    "SetTopic": "meterbridge/gaszaehler/cmd/zaehlerstand",
    "StartOffsetM3": 0.0
  },
  "Stromzaehler": {
    "Enabled": true,
    "SerialPort": "/dev/serial0",
    "BaudRate": 9600,
    "Topic": "meterbridge/stromzaehler/pv"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "MeterBridge.Services.StromzaehlerService": "Debug"
    }
